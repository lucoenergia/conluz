<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Records when a user last changed their own password. Every token issued before that
         instant is rejected, which ends every session opened with the previous password.

         The column is nullable and NULL for every existing row. No backfill: NULL means "the user
         has never changed their password", which is exactly true of every user created before
         this changeset, and it places no restriction on previously issued tokens. Any instant
         written here instead would be invented, and would log out every existing session. -->
    <changeSet id="add_password_changed_at_to_users" author="Víctor Cañizares">
        <preConditions onFail="HALT">
            <not>
                <columnExists tableName="users" columnName="password_changed_at"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="password_changed_at" type="TIMESTAMP WITH TIME ZONE"
                    remarks="When the user last changed their own password. Tokens issued before this instant are rejected. NULL means the password has never been changed, and places no restriction on issued tokens.">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="users" columnName="password_changed_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
