<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- A user whose password was chosen by someone else (created through POST /api/v1/users or a
         CSV import) is flagged as having to change it. Changing the password clears the flag.

         Every existing row gets false through the column default, on purpose: deciding which
         existing users must change their password, and refusing requests while the flag is set,
         is a separate, later step. Until then the flag is informational only. -->
    <changeSet id="add_must_change_password_to_users" author="Víctor Cañizares">
        <preConditions onFail="HALT">
            <not>
                <columnExists tableName="users" columnName="must_change_password"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false"
                    remarks="Whether the user's current password was chosen by someone else and should be changed by the user. Cleared when the user changes their password.">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="users" columnName="must_change_password"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
