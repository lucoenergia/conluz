<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="add_base_url_and_enabled_to_datadis_config" author="Víctor Cañizares">
        <addColumn tableName="datadis_config">
            <column name="base_url" type="TEXT" defaultValue="http://localhost:5555">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <!-- conluz-281: installs upgrading from <= 1.0.76 already had a working Datadis integration
             with no base_url/enabled concept; it was unconditionally active. Any datadis_config row
             that already exists when this changeset runs predates these columns by definition, so
             point it at the real Datadis API and re-enable it instead of silently disabling the
             integration. base_url is domain-only: GetDatadisConsumptionRepositoryRest and
             GetSupplyRepositoryDatadisRest both append their own /api-private/api path, and
             DatadisAuthorizer appends /nikola-auth/tokens/login; two different subpaths on the same
             base, so the legacy .../api-private/api constant is NOT used here. -->
        <sql>
            UPDATE datadis_config
            SET base_url = 'https://datadis.es',
                enabled = true;
        </sql>
        <rollback>
            <dropColumn tableName="datadis_config" columnName="base_url"/>
            <dropColumn tableName="datadis_config" columnName="enabled"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
