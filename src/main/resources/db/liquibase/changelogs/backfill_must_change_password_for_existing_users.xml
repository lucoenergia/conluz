<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Every existing user's password was chosen by whoever created them, so every existing row,
         platform admins included, is flagged as having to change it (#342).

         The rollback clears the flag on every row. It cannot tell the users flagged here apart from
         the users flagged at creation since the column exists (POST /api/v1/users or a CSV import),
         so it clears those too. -->
    <changeSet id="backfill_must_change_password_for_existing_users" author="Víctor Cañizares">
        <preConditions onFail="HALT">
            <columnExists tableName="users" columnName="must_change_password"/>
        </preConditions>
        <update tableName="users">
            <column name="must_change_password" valueBoolean="true"/>
        </update>
        <rollback>
            <update tableName="users">
                <column name="must_change_password" valueBoolean="false"/>
            </update>
        </rollback>
    </changeSet>

</databaseChangeLog>
