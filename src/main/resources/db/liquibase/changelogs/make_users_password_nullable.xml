<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- An account may have no password (#389, ADR-0003 §7): NULL in users.password means the account has
         none, and cannot log in or recover one. No existing row changes: every existing account keeps its
         password.

         The rollback restores NOT NULL only if no account is without a password. A password cannot be
         invented, so otherwise it HALTs, listing the ids of those accounts, and nothing is rolled back. -->
    <changeSet id="make_users_password_nullable" author="Víctor Cañizares">
        <preConditions onFail="HALT">
            <columnExists tableName="users" columnName="password"/>
        </preConditions>
        <dropNotNullConstraint tableName="users"
                               columnName="password"
                               columnDataType="VARCHAR(250)"/>
        <rollback>
            <sql splitStatements="false">
                DO $$
                DECLARE
                    passwordless TEXT;
                BEGIN
                    SELECT string_agg(id::TEXT, ', ' ORDER BY id) INTO passwordless FROM users WHERE password IS NULL;
                    IF passwordless IS NOT NULL THEN
                        RAISE EXCEPTION 'Cannot make users.password NOT NULL again: some accounts have no password (ids: %). Nothing was rolled back. List them with: SELECT id FROM users WHERE password IS NULL; then give them a password or delete them, and roll back again.', passwordless;
                    END IF;
                END
                $$
            </sql>
            <addNotNullConstraint tableName="users"
                                  columnName="password"
                                  columnDataType="VARCHAR(250)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
